<div class="row justify-content-center animate-fade-in mb-5">
  <div class="col-lg-8 text-center">
    <span class="badge bg-success rounded-pill px-3 py-2 mb-2 text-uppercase fw-bold">Live Package Tracking</span>
    <h1 class="fw-bold text-slate-900">Track Your Pet's Climate Transport 🚚</h1>
    <p class="text-muted mb-4">Enter your tracking code or order ID below to view live GPS status and temperature monitoring.</p>

    <div class="card border-0 shadow-lg rounded-4 p-3 bg-white">
      <form action="/api/orders/track" method="GET" class="d-flex gap-2" onsubmit="event.preventDefault(); const code = document.getElementById('trackInput').value; if(code) window.location.href = '/api/orders/track/' + code;">
        <input type="text" id="trackInput" required class="form-control form-control-lg border-0 bg-light rounded-pill px-4 fs-6" placeholder="Enter tracking code (e.g. TRACK-PET-849201)">
        <button type="submit" class="btn btn-primary btn-gradient rounded-pill px-4 fw-bold">Track</button>
      </form>
    </div>
  </div>
</div>

<div class="row g-4 animate-fade-in">
  <div class="col-12">
    <h4 class="fw-bold mb-4">Recent Orders & Tracking History</h4>
  </div>

  <% if (orders && orders.length > 0) { %>
    <% orders.forEach(ord => { %>
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <strong class="text-slate-900 d-block"><%= ord.custom_id || ord.id %></strong>
              <small class="text-muted"><%= ord.tracking_code %></small>
            </div>
            <span class="badge bg-success-subtle text-success fw-bold rounded-pill px-3 py-1"><%= ord.tracking_status %></span>
          </div>

          <div class="d-flex align-items-center gap-3 mb-3">
            <img src="<%= ord.pet_image %>" class="rounded-3 object-cover" width="65" height="65" alt="<%= ord.pet_title %>">
            <div>
              <h6 class="fw-bold mb-1"><%= ord.pet_title %></h6>
              <span class="text-primary fw-bold">$<%= ord.total_amount %></span>
              <small class="text-muted d-block"><i class="fa-solid fa-truck me-1"></i> Delivery: <%= ord.estimated_delivery %></small>
            </div>
          </div>

          <div class="mt-3 pt-3 border-top">
            <div class="d-flex justify-content-between small text-muted">
              <span>Buyer: <%= ord.buyer_name %></span>
              <span>Payment: <%= ord.payment_method %></span>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
      <p class="text-muted mb-0">No active orders found.</p>
    </div>
  <% } %>
</div>
