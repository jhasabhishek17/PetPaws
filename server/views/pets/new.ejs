<div class="row justify-content-center animate-fade-in">
  <div class="col-lg-8">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
      <h2 class="fw-bold text-slate-900 mb-2">List a Pet for Sale 🐾</h2>
      <p class="text-muted mb-4">Provide accurate pet details, health certifications, and pricing.</p>

      <form action="/api/pets" method="POST" id="newPetForm">
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label fw-semibold">Listing Title</label>
            <input type="text" name="title" required class="form-control rounded-3" placeholder="e.g. Golden Retriever Puppy">
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Category</label>
            <select name="category" class="form-select rounded-3">
              <option value="Dogs">Dogs</option>
              <option value="Cats">Cats</option>
              <option value="Fishes">Fishes</option>
              <option value="Rabbits">Rabbits</option>
              <option value="Birds">Birds</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label fw-semibold">Price ($ USD)</label>
            <input type="number" name="price" required class="form-control rounded-3" placeholder="e.g. 750">
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Breed</label>
            <input type="text" name="breed" class="form-control rounded-3" placeholder="e.g. Purebred">
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Age</label>
            <input type="text" name="age" class="form-control rounded-3" placeholder="e.g. 12 Weeks">
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Gender</label>
            <select name="gender" class="form-select rounded-3">
              <option value="Male">Male</option>
              <option value="Female">Female</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Available Stock</label>
            <input type="number" name="stock" value="1" class="form-control rounded-3">
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Image URL</label>
            <input type="url" name="image_url" class="form-control rounded-3" placeholder="https://images.unsplash.com/...">
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Description</label>
            <textarea name="description" rows="4" class="form-control rounded-3" placeholder="Describe personality, diet, training level..."></textarea>
          </div>
        </div>

        <div class="mt-4 pt-3 border-top text-end">
          <a href="/" class="btn btn-light rounded-pill px-4 me-2">Cancel</a>
          <button type="submit" class="btn btn-primary btn-gradient rounded-pill px-5 fw-bold">Publish Listing</button>
        </div>
      </form>
    </div>
  </div>
</div>
