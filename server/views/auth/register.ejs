<div class="row justify-content-center animate-fade-in py-4">
  <div class="col-md-7 col-lg-6">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
      <div class="text-center mb-4">
        <span class="fs-1 animate-float d-block">🐾</span>
        <h3 class="fw-bold text-slate-900 mt-2">Create an Account</h3>
        <p class="text-muted small">Join PetPaws as a Pet Buyer, Seller, or Veterinarian</p>
      </div>

      <form action="/api/auth/register" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Full Name</label>
            <input type="text" name="name" required class="form-control rounded-3" placeholder="Jane Doe">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Account Role</label>
            <select name="role" class="form-select rounded-3">
              <option value="buyer">Buyer</option>
              <option value="seller">Seller / Breeder</option>
              <option value="vet">Veterinarian</option>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Email Address</label>
            <input type="email" name="email" required class="form-control rounded-3" placeholder="jane@example.com">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Password</label>
            <input type="password" name="password" required class="form-control rounded-3" placeholder="••••••••">
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Phone Number</label>
            <input type="text" name="phone" class="form-control rounded-3" placeholder="+1 (555) 000-0000">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Shipping / Clinic Address</label>
            <input type="text" name="address" class="form-control rounded-3" placeholder="123 Main St, City">
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-gradient w-100 py-3 rounded-pill fw-bold shadow mt-4">
          Create Account
        </button>
      </form>

      <div class="text-center mt-4 pt-3 border-top small">
        <span class="text-muted">Already registered?</span>
        <a href="/login" class="fw-bold text-primary text-decoration-none ms-1">Sign In</a>
      </div>
    </div>
  </div>
</div>
