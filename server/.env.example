PORT=5001
NODE_ENV=development

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/petpaws?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

ALLOWED_ORIGINS=http://localhost:5173,https://petpaws-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# Reverse Proxy (Render / Production)
# Render uses a single reverse proxy hop in front of Node services.
# Setting TRUST_PROXY=1 allows Express & express-rate-limit to determine client IPs
# and prevents ERR_ERL_UNEXPECTED_X_FORWARDED_FOR errors.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Transactional Email Service Configuration (Verification & Password Reset)
#
# IMPORTANT ON RENDER:
# Render firewalls outbound TCP connections on SMTP ports 25, 465, and 587.
# Therefore, connecting directly to smtp.gmail.com:465/587 will TIME OUT on Render.
#
# RECOMMENDED FOR RENDER: Option A (Resend HTTPS API over port 443)
# Get a free API key at https://resend.com and set RESEND_API_KEY.
# ---------------------------------------------------------------------------
EMAIL_FROM="PetPaws <no-reply@your-verified-domain.com>"

# Option A (Recommended on Render): Resend HTTPS API
RESEND_API_KEY=re_your_resend_api_key_here
# Optional: If you don't have a verified custom domain yet on Resend,
# leave RESEND_FROM unset (defaults automatically to PetPaws <onboarding@resend.dev>)
# RESEND_FROM="PetPaws <onboarding@resend.dev>"

# Option B: Brevo or SendGrid HTTPS API (optional alternatives)
BREVO_API_KEY=
SENDGRID_API_KEY=

# Option C: Standard SMTP / SMTPS (Works locally or on servers with unblocked SMTP)
# For Gmail SMTP: use port 465 with secure=true (or port 587 with STARTTLS)
# Gmail App Password (16 characters, spaces are automatically stripped if present)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_app_password
EMAIL_SERVICE=gmail

# Optional OTP Sending Rate-Limit Overrides (defaults shown below)
# OTP_RESEND_COOLDOWN_MS=60000
# OTP_EMAIL_HOURLY_LIMIT=3
# OTP_EMAIL_DAILY_LIMIT=5
# OTP_IP_HOURLY_LIMIT=30
# OTP_IP_DAILY_LIMIT=60

# ---------------------------------------------------------------------------
# Media Uploads (Cloudinary)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=petpaws

MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=50
MAX_UPLOAD_FILES=6

SERVE_CLIENT_DIST=false

ADMIN_INITIAL_PASSWORD=replace_with_a_strong_admin_password
DEMO_USER_INITIAL_PASSWORD=replace_with_a_strong_demo_password
