PORT=5001
NODE_ENV=development

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/petpaws?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

ALLOWED_ORIGINS=http://localhost:5173,https://petpaws-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Transactional Email Service Configuration (Verification & Password Reset)
# Configure ONE of the following providers in production (Render):
# Option A (Recommended on Render): Resend HTTPS API
# Option B: Brevo (Sendinblue) or SendGrid HTTPS API
# Option C: Standard SMTP / SMTPS / STARTTLS
# ---------------------------------------------------------------------------
EMAIL_FROM="PetPaws <no-reply@your-verified-domain.com>"

# Option A: Resend HTTPS API
RESEND_API_KEY=re_your_resend_api_key_here

# Option B: Brevo or SendGrid HTTPS API (optional alternatives)
BREVO_API_KEY=
SENDGRID_API_KEY=

# Option C: SMTP Server Credentials (Nodemailer)
# Supports SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS or EMAIL_HOST/EMAIL_PORT/EMAIL_USER/EMAIL_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_app_password
EMAIL_SERVICE=gmail

# Optional OTP Sending Rate-Limit Overrides (defaults shown below)
# OTP_RESEND_COOLDOWN_MS=60000
# OTP_EMAIL_HOURLY_LIMIT=3
# OTP_EMAIL_DAILY_LIMIT=5
# OTP_IP_HOURLY_LIMIT=30
# OTP_IP_DAILY_LIMIT=60

# ---------------------------------------------------------------------------
# Media Uploads (Cloudinary)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=petpaws

MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=50
MAX_UPLOAD_FILES=6

SERVE_CLIENT_DIST=false

ADMIN_INITIAL_PASSWORD=replace_with_a_strong_admin_password
DEMO_USER_INITIAL_PASSWORD=replace_with_a_strong_demo_password
