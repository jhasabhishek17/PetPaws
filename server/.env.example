# Server Port
PORT=5001

# Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection URI
# - In production (NODE_ENV=production), MONGODB_URI is REQUIRED and must be your MongoDB Atlas SRV URI.
# - In development, defaults to mongodb://127.0.0.1:27017/petpaws if omitted.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/petpaws?retryWrites=true&w=majority

# JWT Authentication Secret (REQUIRED in production — use a 32+ char random secret)
JWT_SECRET=your_strong_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated frontend URLs in production)
ALLOWED_ORIGINS=http://localhost:5173,https://your-petpaws-frontend.vercel.app

# Cloudinary Persistent Media Storage (Images & Videos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=petpaws

# Upload Size & Count Limits
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=50
MAX_UPLOAD_FILES=6

# Set to 'true' if serving the built React frontend (client/dist) directly from this Express server
SERVE_CLIENT_DIST=false
